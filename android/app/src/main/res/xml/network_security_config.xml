<?xml version="1.0" encoding="utf-8"?>
<!-- 正式包只信任系统 CA。迁移 CA（mytv_migration_ca）仅供本机 Debug 联调，
     由 src/debug/res/xml/network_security_config.xml 覆盖，不得进入 Release。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
