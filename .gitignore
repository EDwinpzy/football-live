# 网页版构建产物（deploy/selfhosted/Dockerfile.web 内生成，不入库）
tools/web-dist/
# otv-admin 的签名依赖 vendor/（由 tools/vendor/*.whl 解包生成，11MB 二进制，不入库）
cloudfunctions/otv-admin/vendor/

# VOD 影视索引/抓取运行期缓存（本地代理自动生成，不入库）
tools/backend-src/.cache/

# 内嵌的后台管理项目（独立 git 仓库：站点 Worker + D1 + R2，不并入主项目）
后台管理系统/

# CloudBase 已退役，这些是本地残留的历史配置与云函数包。
# cloudbaserc.json 无任何代码读取；cloudfunctions/ 的 otv-web / otv-admin
# 早已不被部署流程引用（quickjs 依赖已迁到 tools/backend-src/vendor/）。
# 忽略而不是提交，避免它们重新混进仓库。
cloudbaserc.json
cloudfunctions/

# 本机 adb 调试导出（ui dump / 截图清单）
out-*.xml

# 本机工具状态与会话产物：只在本机留证，不入库
#   .superpowers/  superpowers 头脑风暴的本地服务状态（端口 / pid / 本机会话 key）
#   artifacts/     测试截图与实机证据（docs 里按本机路径引用，体积大且会随磁盘清理淘汰）
#   work/          会话临时输出（logcat、uiautomator dump、流探针、预览草稿）
.env
deploy/selfhosted/.env
.superpowers/
artifacts/
work/
# 2026-09-20 搜索页会话遗留的一次性 adb 导出（与上面的 out-*.xml 同类）
search-screen-*.png
search-ui-*.xml

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
env/

