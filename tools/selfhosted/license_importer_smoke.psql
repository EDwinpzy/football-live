\set ON_ERROR_STOP on

SELECT 'OTV-' || substr(v_code, 1, 5) || '-' || substr(v_code, 6, 5) AS smoke_code
FROM (
    SELECT translate(
        upper(md5(clock_timestamp()::text || random()::text)), '01', '23'
    ) AS v_code
) generated
\gset

BEGIN;
SET LOCAL ROLE license_importer;
SET LOCAL otv.license_importer_smoke_code = :'smoke_code';

INSERT INTO public.licenses (code, plan, days, ticket, note)
VALUES (:'smoke_code', 'monthly', 30, '{"smoke": true}'::jsonb, 'role smoke test')
ON CONFLICT (code) DO NOTHING
;
-- \gset raises "no rows returned" on an empty result, so asserting via
-- RETURNING is fragile. Count the row the importer role actually wrote.
-- license_importer only holds SELECT (code) on licenses, so the assertion
-- must not read any other column.
SELECT count(*) AS inserted_rows
FROM public.licenses
WHERE code = :'smoke_code'
\gset
\if :inserted_rows = '0'
\echo license_importer insert privilege smoke test failed
\quit 3
\endif

INSERT INTO public.licenses (code, plan, days, ticket, note)
VALUES (:'smoke_code', 'monthly', 30, '{"smoke": true}'::jsonb, 'duplicate smoke test')
ON CONFLICT (code) DO NOTHING
-- The duplicate insert must affect no rows. \gset is unusable here: it raises
-- "no rows returned for \gset" on an empty result, which is exactly the
-- outcome this asserts. The role can only read the code column, so this
-- compares the total row count for that code instead of filtering on note.
;
SELECT count(*) AS duplicate_rows FROM public.licenses WHERE code = :'smoke_code'
\gset
-- Exactly one row means the first insert stands and the duplicate was dropped.
\if :duplicate_rows <> '1'
\echo license_importer duplicate import smoke test failed
\quit 3
\endif

-- count(*) always returns exactly one row, so \gset cannot fail here.
SELECT count(*) AS found_rows
FROM public.licenses
WHERE code = :'smoke_code'
\gset
\if :found_rows = '0'
\echo license_importer code-only read smoke test failed
\quit 3
\endif

DO $test_prohibited_read$
DECLARE
    v_denied boolean := false;
BEGIN
    BEGIN
        PERFORM ticket
        FROM public.licenses
        WHERE code = current_setting('otv.license_importer_smoke_code');
    EXCEPTION WHEN insufficient_privilege THEN
        v_denied := true;
    END;
    IF NOT v_denied THEN
        RAISE EXCEPTION 'license_importer unexpectedly read license details';
    END IF;
END
$test_prohibited_read$;

DO $test_prohibited_update$
DECLARE
    v_denied boolean := false;
BEGIN
    BEGIN
        UPDATE public.licenses
        SET note = note
        WHERE code = current_setting('otv.license_importer_smoke_code');
    EXCEPTION WHEN insufficient_privilege THEN
        v_denied := true;
    END;
    IF NOT v_denied THEN
        RAISE EXCEPTION 'license_importer unexpectedly updated a license';
    END IF;
END
$test_prohibited_update$;

RESET ROLE;
ROLLBACK;
