-- Reconcile the importer role every deployment so password rotation and grant
-- drift are repaired before PostgREST or the admin API can start.
BEGIN;
\ir license_importer_role.sql
INSERT INTO public.schema_migrations (version, sql_sha256)
VALUES ('license_importer_role_v1', :'license_importer_role_sha256')
ON CONFLICT (version) DO UPDATE
SET applied_at = EXCLUDED.applied_at,
    sql_sha256 = EXCLUDED.sql_sha256;
COMMIT;

\ir license_importer_smoke.psql
