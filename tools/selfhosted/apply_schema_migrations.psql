    SELECT 1 FROM public.schema_migrations WHERE version = 'license_v2_migration.sql'
) AS migration_pending \gset
\if :migration_pending
BEGIN;
\ir ../license_v2_migration.sql
INSERT INTO public.schema_migrations (version, sql_sha256)
