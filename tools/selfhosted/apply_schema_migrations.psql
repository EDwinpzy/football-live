\set ON_ERROR_STOP on

CREATE TABLE IF NOT EXISTS public.schema_migrations (
    version text PRIMARY KEY,
    applied_at timestamptz NOT NULL DEFAULT now()
);

SELECT NOT EXISTS (
    SELECT 1 FROM public.schema_migrations WHERE version = 'db_bootstrap.sql'
) AS migration_pending \gset
\if :migration_pending
BEGIN;
\ir db_bootstrap.sql
INSERT INTO public.schema_migrations (version) VALUES ('db_bootstrap.sql');
COMMIT;
\endif

SELECT NOT EXISTS (
    SELECT 1 FROM public.schema_migrations WHERE version = 'base_schema.sql'
) AS migration_pending \gset
\if :migration_pending
BEGIN;
\ir base_schema.sql
INSERT INTO public.schema_migrations (version) VALUES ('base_schema.sql');
COMMIT;
\endif

