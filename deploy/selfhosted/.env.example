# Copy to .env on the VPS and set file mode to 0600 before starting Compose.
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_USER=otv_admin
POSTGRES_PASSWORD=replace-with-a-random-secret
POSTGRES_DB=optimal_tv
POSTGREST_DB_USER=authenticator
POSTGREST_DB_PASSWORD=replace-with-a-different-random-secret
JWT_SIGNING_KEY=replace-with-a-random-key-at-least-32-characters
AUTH_SECRETS_HOST_PATH=/srv/mytv/secrets
ADMIN_SECRETS_HOST_PATH=/srv/mytv/secrets
LICENSE_SECRETS_HOST_PATH=/srv/mytv/secrets/license
OBJECTS_HOST_PATH=/srv/mytv/objects
METADATA_HOST_PATH=/srv/mytv/metadata
HEALTH_HOST_PORT=8080
OTV_PUBLIC_BASE_URL=https://103.236.97.137:35208
OTV_HU_OFF=0
